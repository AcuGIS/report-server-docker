# AcuGIS Report Server 1.0.21
# Reference only. A normal install does not copy this file.
#
#   docker compose run --rm -it report-server-setup
#   docker compose up -d
#
# setup writes .env, generates JRS_DB_PASS and JRS_DESIGNER_INTERNAL_TOKEN,
# and asks for the administrator password and timezone. It does not print
# either secret. Values already in .env are kept across restarts and upgrades
# unless setup is told to replace them. Report Server is published on port
# 9088. Designer Web listens on 127.0.0.1:8787 inside the Report Server
# network namespace and that port is not published.
# ACUGIS_EDITION does not grant Professional features.
#
# Customer Compose pulls a published image. It does not build the application.
# Default image when REPORT_SERVER_IMAGE is unset:
#   acugis/report-server:1.0.21-professional
# Open Source:
# REPORT_SERVER_IMAGE=acugis/report-server:1.0.21-oss
#
# Local source build (compose.build.yml). Does not replace the customer file.
#   SOURCE_REVISION=<40-hex> docker compose -f compose.yml -f compose.build.yml up -d --build
# BUILD_EDITION=professional

# ---------------------------------------------------------------------------
# Passwords. setup writes these. The example values below cannot start the stack.
# ---------------------------------------------------------------------------
# JRS_DB_PASS is generated. JRS_ADMIN_PASSWORD is the password you enter.

JRS_DB_PASS=change-me-strong-password
JRS_ADMIN_PASSWORD=change-me-admin-password

# JRS_DESIGNER_INTERNAL_TOKEN is generated by setup. Do not copy a token here.

JRS_HOST_PORT=9088

# ---------------------------------------------------------------------------
# Application PostgreSQL (Compose service "postgres" by default)
# For external PostgreSQL: set these and remove/disable the postgres service.
# ---------------------------------------------------------------------------
JRS_DB_NAME=jasper_reports
JRS_DB_USER=jasper
JRS_DB_SCHEMA=public
JRS_DB_SSLMODE=disable

# ---------------------------------------------------------------------------
# Initial administrator (existing scripts/seed_admin.php — unchanged)
# ---------------------------------------------------------------------------
JRS_ADMIN_USER=admin

# ---------------------------------------------------------------------------
# Optional: host bind mount for local DuckDB/SQLite/GeoPackage files
# Appears inside the container as /data
# ---------------------------------------------------------------------------
JRS_DATA_HOST_PATH=./data

# ---------------------------------------------------------------------------
# Packaging: seed demo hello report + DemoPG datasource on first boot (1/0)
# ---------------------------------------------------------------------------
ACUGIS_DOCKER_SEED_DEMO=1

# ---------------------------------------------------------------------------
# Timezone (IANA name). Used by calendar / once schedules in Docker.
# Native Ubuntu uses the host timezone via systemd. Set the same value on
# report-server and report-scheduler (Compose applies TZ to both).
# ---------------------------------------------------------------------------
TZ=UTC

# ---------------------------------------------------------------------------
# Optional existing application settings (uncomment as needed)
# ---------------------------------------------------------------------------
# JRS_ENVIRONMENT=production
# JRS_APP_VERSION=1.0.0
# JRS_BASE_PATH=/
# JRS_SMTP_HOST=
# JRS_SMTP_PORT=587
# JRS_SMTP_USER=
# JRS_SMTP_PASS=
# JRS_SMTP_FROM=reports@example.com
# JRS_SMTP_HELO=example.com
# JRS_SCHEDULER_POLL_INTERVAL=15s
# JRS_DB_HOST=postgres
# JRS_DB_PORT=5432

# Optional QGIS Server companion (docker compose --profile qgis)
# JRS_QGIS_UPSTREAM=http://qgis-server
# JRS_QGIS_MAP_PREFIX=/qgis/projects

# ACUGIS_EMBED_TOKEN_SECRET=
# ACUGIS_EMBED_ALLOWED_ORIGINS=
# ACUGIS_OIDC_ENABLED=false
# ACUGIS_SAML_ENABLED=false
